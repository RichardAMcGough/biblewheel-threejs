{
  "name": "biblewheel-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",

    "// Angular (original) — run from this folder for easy side-by-side comparison": "",
    "serve:angular": "npm --prefix ../biblewheel start",
    "serve:angular:open": "npm --prefix ../biblewheel start -- --open",
    "build:angular": "npm --prefix ../biblewheel run build",
    "watch:angular": "npm --prefix ../biblewheel run watch"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/three": "^0.184.1",
    "lucide-react": "^0.544.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0",
    "troika-three-text": "^0.52.4"
  }
}
